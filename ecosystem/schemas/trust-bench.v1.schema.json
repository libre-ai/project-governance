{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:libre-ai:schema:trust-bench:v1",
  "title": "libre-ai.trust-bench.v1 — the published measures of the seeded-defect bench",
  "description": "distribution/index/trust-bench.v1.json, generated by verification/trust-bench/build-evidence.ts from the record of a measure under verification/trust-bench/, never written by hand. One entry per measure: the repository and revision measured, the date, the models, the synthesis by layer as the bench computed it, and by case which layer went red. Every figure is relayed from the record; the generator cross-checks the record against itself before writing. A second pass taken under other conditions is published apart, never merged into the reference. A measure carries its limits: a consumer that shows the figures shows them too.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "mesures"],
  "properties": {
    "schema_version": { "const": "libre-ai.trust-bench.v1" },
    "source": { "const": "verification/trust-bench/build-evidence.ts" },
    "mesures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mesure" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "count": { "type": "integer", "minimum": 0 },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fichier", "sha256"],
      "properties": {
        "fichier": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "interruption": {
      "description": "Why a layer of the launcher gave no verdict: `delai` when it outlived its delay and the launcher stopped it, `signal <NAME>` when a signal the launcher did not send killed it. Null when the layer finished by itself, and for a review or derived layer, which the launcher does not run. An interrupted layer is neither green nor red. The raw lines of the passes of 2026-11-16 predate the `signal` field: a death by signal would have been recorded there as a delay.",
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(delai|signal [A-Za-z0-9]+)$" }
      ]
    },
    "etat_lance": {
      "description": "The state of one run of a launched layer.",
      "type": "string",
      "pattern": "^(vert|rouge|delai|signal [A-Za-z0-9]+)$"
    },
    "mesure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "depot",
        "revision",
        "corpus",
        "couches",
        "defauts_attrapes_par_aucune_couche",
        "cas",
        "relecture",
        "modeles",
        "reference",
        "second_passage",
        "limites",
        "fichiers_d_origine",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "depot": { "type": "string", "pattern": "^libre-ai/[a-z0-9.][a-z0-9.-]*$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fichier", "defauts", "sains"],
          "properties": {
            "fichier": { "$ref": "#/$defs/path" },
            "defauts": { "$ref": "#/$defs/count" },
            "sains": {
              "description": "Healthy cases, the original revision included.",
              "$ref": "#/$defs/count"
            }
          }
        },
        "couches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "couche",
              "cout",
              "derivee_de",
              "defauts_soumis",
              "defauts_attrapes",
              "apport_au_dela_du_moins_cher",
              "cas_de_l_apport",
              "sains_soumis",
              "faux_positifs",
              "cas_faux_positifs",
              "illisibles",
              "duree_totale_ms",
              "commande"
            ],
            "properties": {
              "couche": { "type": "string", "minLength": 1 },
              "cout": {
                "description": "An order set by hand, not a measure.",
                "type": "integer",
                "minimum": 1
              },
              "derivee_de": {
                "description": "Null for a layer with verdicts of its own. For a derived layer, the layers whose verdicts it combines: everything it reports, one of them reports already.",
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "string", "minLength": 1 }
                  }
                ]
              },
              "defauts_soumis": { "$ref": "#/$defs/count" },
              "defauts_attrapes": { "$ref": "#/$defs/count" },
              "apport_au_dela_du_moins_cher": {
                "description": "Defects caught by the layer and by no layer of its own of strictly lower cost. Null, not applicable, for a derived layer: against the layers it is derived from it would be 0 whatever the input, which is not a measure. A consumer never shows it as 0.",
                "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }]
              },
              "cas_de_l_apport": {
                "description": "Null for a derived layer, like the contribution.",
                "anyOf": [{ "$ref": "#/$defs/cases" }, { "type": "null" }]
              },
              "sains_soumis": { "$ref": "#/$defs/count" },
              "faux_positifs": { "$ref": "#/$defs/count" },
              "cas_faux_positifs": { "$ref": "#/$defs/cases" },
              "illisibles": {
                "description": "Answers that are neither a green nor a red.",
                "$ref": "#/$defs/count"
              },
              "duree_totale_ms": { "$ref": "#/$defs/count" },
              "commande": {
                "description": "The command of a layer the launcher runs; null for a review or crossed layer.",
                "type": ["array", "null"],
                "items": { "type": "string" }
              }
            },
            "if": { "properties": { "derivee_de": { "type": "null" } } },
            "then": {
              "properties": {
                "apport_au_dela_du_moins_cher": { "type": "integer" },
                "cas_de_l_apport": { "type": "array" }
              }
            },
            "else": {
              "properties": {
                "apport_au_dela_du_moins_cher": { "type": "null" },
                "cas_de_l_apport": { "type": "null" }
              }
            }
          }
        },
        "defauts_attrapes_par_aucune_couche": { "$ref": "#/$defs/cases" },
        "cas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "attendu", "nature", "origine", "verdicts"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "attendu": {
                "description": "True for a seeded defect, false for a healthy case.",
                "type": "boolean"
              },
              "nature": { "type": "string" },
              "origine": { "type": ["string", "null"] },
              "verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["couche", "rouge", "illisible", "interruption", "ms"],
                  "properties": {
                    "couche": { "type": "string", "minLength": 1 },
                    "rouge": { "type": "boolean" },
                    "illisible": {
                      "description": "Neither a green nor a red: an answer of a model that is not a verdict, or a layer of the launcher that was interrupted.",
                      "type": "boolean"
                    },
                    "interruption": { "$ref": "#/$defs/interruption" },
                    "ms": { "$ref": "#/$defs/count" }
                  }
                }
              }
            }
          }
        },
        "relecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serveur",
            "temperature",
            "seed",
            "max_tokens",
            "langue_de_la_consigne",
            "consigne",
            "passages_par_modele"
          ],
          "properties": {
            "serveur": { "type": "string" },
            "temperature": { "type": "number", "minimum": 0 },
            "seed": { "type": "integer" },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "langue_de_la_consigne": { "type": "string" },
            "consigne": { "$ref": "#/$defs/path" },
            "passages_par_modele": { "type": "integer", "minimum": 1 }
          }
        },
        "modeles": {
          "type": "array",
          "items": {
            "description": "A model is identified by the fingerprint of its file or by its upstream revision: one of the two is recorded.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "couche",
              "etiquette",
              "nom",
              "quantification",
              "fichier",
              "source_amont",
              "revision_amont",
              "sha256",
              "octets",
              "licence"
            ],
            "properties": {
              "couche": { "type": "string", "minLength": 1 },
              "etiquette": { "type": "string", "minLength": 1 },
              "nom": { "type": "string", "minLength": 1 },
              "quantification": { "type": "string", "minLength": 1 },
              "fichier": { "$ref": "#/$defs/path" },
              "source_amont": { "type": ["string", "null"] },
              "revision_amont": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
              "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "octets": { "type": ["integer", "null"], "minimum": 1 },
              "licence": { "type": ["string", "null"] }
            },
            "anyOf": [
              { "properties": { "sha256": { "type": "string" } } },
              { "properties": { "revision_amont": { "type": "string" } } }
            ]
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fichier", "condition"],
          "properties": {
            "fichier": { "$ref": "#/$defs/path" },
            "condition": { "type": "string", "minLength": 1 }
          }
        },
        "second_passage": {
          "description": "A pass taken under other conditions, published apart: none of its verdicts enters the synthesis.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fichier",
            "condition",
            "statut",
            "lignes_comparees",
            "verdicts",
            "bascules"
          ],
          "properties": {
            "fichier": { "$ref": "#/$defs/path" },
            "condition": { "type": "string", "minLength": 1 },
            "statut": { "type": "string", "minLength": 1 },
            "lignes_comparees": { "$ref": "#/$defs/count" },
            "verdicts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cas", "couche", "attrape", "code", "interruption", "ms"],
                "properties": {
                  "cas": { "type": "string", "minLength": 1 },
                  "couche": { "type": "string", "minLength": 1 },
                  "attrape": { "type": "boolean" },
                  "code": {
                    "description": "The exit code of the layer; null when it gave none.",
                    "type": ["integer", "null"]
                  },
                  "interruption": { "$ref": "#/$defs/interruption" },
                  "ms": { "$ref": "#/$defs/count" }
                }
              }
            },
            "bascules": {
              "description": "The runs whose state differs from the reference: a verdict that changed, or an interruption on one side only.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cas", "couche", "reference", "second_passage"],
                "properties": {
                  "cas": { "type": "string", "minLength": 1 },
                  "couche": { "type": "string", "minLength": 1 },
                  "reference": { "$ref": "#/$defs/etat_lance" },
                  "second_passage": { "$ref": "#/$defs/etat_lance" }
                }
              }
            }
          }
        },
        "limites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fichiers_d_origine": {
          "description": "The files as the bench wrote them, by their name on the measuring side and their fingerprint; they are not published. The versioned sources hold the same objects, laid out for this repository.",
          "type": "array",
          "items": { "$ref": "#/$defs/fingerprint" }
        },
        "sources": {
          "description": "The versioned files the generator read, with their fingerprint.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fingerprint" }
        }
      }
    }
  }
}
