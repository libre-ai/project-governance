{
  "name": "@libre-ai/governance",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1",
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "fast-uri": "4.1.4"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "entities": "8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check:bun:runtime": "bun tools/quality/check-bun-minimum.ts",
    "check:bun": "bun run check:bun:runtime && bun tools/quality/check-bun-manifests.ts",
    "check:toolchain": "bun run check:bun && bun tools/quality/check-toolchain.ts",
    "check:secret-scan": "bun run check:bun:runtime && bun tools/quality/check-secret-scan.ts",
    "check:personal-data": "bun run check:bun:runtime && bun tools/quality/check-personal-data-boundary.ts",
    "lint": "bun run check:bun:runtime && biome ci tools/quality",
    "typecheck": "bun run check:bun:runtime && tsc --noEmit -p tsconfig.json",
    "test": "bun test tools/quality",
    "check": "bun run check:bun && bun run check:toolchain && bun run check:secret-scan && bun run check:personal-data && bun run lint && bun run typecheck && bun run test",
    "pretest": "bun run check:bun"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/libre-ai/project-governance.git"
  },
  "files": [
    "tools/quality",
    "toolchains",
    "LICENSE",
    "LICENSES",
    "docs/parity/draft-specs/DRAFT-SPEC-memory.md",
    "docs/specifications/IDENTITY-AUTHORIZATION.md",
    "ecosystem/portfolio.v1.json"
  ]
}
