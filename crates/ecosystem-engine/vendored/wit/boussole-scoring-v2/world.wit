package libre-ai:boussole-scoring@2.0.0;

interface api {
  enum refusal-code {
    input-invalid,
    digest-mismatch,
    approval-invalid,
    method-unsupported,
    response-invalid,
    denominator-zero,
    computed-at-invalid,
    resource-limit-exceeded,
  }

  record contract-error {
    code: refusal-code,
  }

  /// Inputs conform to public-vote-dataset.v2, boussole-method.v2 and
  /// boussole-response-set.v2. Success is local-comparison.v2 JCS JSON.
  compare: func(
    dataset: list<u8>,
    method: list<u8>,
    responses: list<u8>,
    computed-at: string,
  ) -> result<list<u8>, contract-error>;
}

/// Pure local comparison component. SEMANTICS.md is normative.
/// The component imports no network, storage, clock, randomness, identity or logging capability.
world boussole-scoring {
  export api;
}
