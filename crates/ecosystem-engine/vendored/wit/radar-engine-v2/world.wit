package libre-ai:radar-engine@2.0.0;

interface api {
  /// Closed refusal set. A refusal contains no payload excerpt, URL, identifier,
  /// rule value, tenant value, parser diagnostic or implementation detail.
  enum refusal-code {
    invalid-limits,
    invalid-source,
    body-too-large,
    output-too-large,
    media-type-unsupported,
    encoding-unsupported,
    feed-malformed,
    feed-kind-unsupported,
    xml-dtd-forbidden,
    xml-entity-forbidden,
    max-depth-exceeded,
    max-items-exceeded,
    json-invalid,
    json-not-canonical,
    item-invalid,
    rule-invalid,
  }

  record contract-error {
    code: refusal-code,
  }

  /// Normative ranges and counting rules are fixed by PROFILE.md section 3.
  record parse-limits {
    max-input-bytes: u64,
    max-output-bytes: u64,
    max-items: u32,
    max-depth: u32,
  }

  /// Accepts only the media types and feed dialects in PROFILE.md section 2.
  /// On success returns RFC 8785 canonical JSON conforming exactly to
  /// contracts/schemas/radar-normalized-feed.v1.schema.json.
  parse-feed: func(
    payload: list<u8>,
    media-type: string,
    source-id: string,
    base-url: string,
    limits: parse-limits,
  ) -> result<list<u8>, contract-error>;

  /// `item` is RFC 8785 canonical radar-normalized-item.v1 JSON and `rules` is
  /// RFC 8785 canonical curation-rule-set.v2 JSON. On success returns RFC 8785
  /// canonical radar-rule-evaluation.v1 JSON. PROFILE.md section 8 defines fixed
  /// input-byte ceilings plus complete matching, precedence and default-decision
  /// semantics.
  evaluate-rules: func(item: list<u8>, rules: list<u8>) -> result<list<u8>, contract-error>;
}

/// Pure, capability-free Radar parser and rule evaluator.
/// PROFILE.md in this package is normative for accepted feed dialects,
/// normalization, ordering, deduplication, refusal precedence and RFC 8785 output.
world radar-engine {
  export api;
}
