[
  {
    "name": "ampersand not escaped",
    "find": ".replaceAll(\"&\", \"&amp;\")",
    "replace": ".replaceAll(\"&\", \"&\")"
  },
  {
    "name": "opening angle bracket not escaped",
    "find": ".replaceAll(\"<\", \"&lt;\")",
    "replace": ".replaceAll(\"<\", \"<\")"
  },
  {
    "name": "closing angle bracket not escaped",
    "find": ".replaceAll(\">\", \"&gt;\")",
    "replace": ".replaceAll(\">\", \">\")"
  },
  {
    "name": "double quote not escaped",
    "find": ".replaceAll('\"', \"&quot;\")",
    "replace": ".replaceAll('\"', '\"')"
  },
  {
    "name": "single quote not escaped",
    "find": ".replaceAll(\"'\", \"&#39;\");",
    "replace": ".replaceAll(\"'\", \"'\");"
  },
  {
    "name": "inline text not escaped before code spans",
    "find": "return escapeHtml(text).replace(/`([^`]+)`/g, \"<code>$1</code>\");",
    "replace": "return text.replace(/`([^`]+)`/g, \"<code>$1</code>\");"
  },
  {
    "name": "list item continuation dropped",
    "find": "items[items.length - 1] = `${items.at(-1)} ${line}`;",
    "replace": "items[items.length - 1] = `${items.at(-1)}`;"
  },
  {
    "name": "count of one agreed in the plural",
    "find": "return `${value} ${value > 1 ? plural : singular}`;",
    "replace": "return `${value} ${plural}`;"
  },
  {
    "name": "table left outside a scrollable region",
    "find": "return `<section class=\"defilante\" aria-label=\"${escapeHtml(label)}\">${table}</section>`;",
    "replace": "return table;"
  },
  {
    "name": "dependency count not accumulated",
    "find": "row.set(target, (row.get(target) ?? 0) + 1);",
    "replace": "row.set(target, 1);"
  },
  {
    "name": "dependency on an unknown brick counted",
    "find": "if (target !== undefined) row.set(",
    "replace": "row.set((target ?? layer.slug),"
  },
  {
    "name": "admitted cell decided by the wrong layer",
    "find": "return layer.mayDependOn.includes(target.slug)",
    "replace": "return target.mayDependOn.includes(layer.slug)"
  },
  {
    "name": "diagonal not told apart",
    "find": "if (target.slug === layer.slug) return `<td class=\"interne\">${declared}</td>`;",
    "replace": "if (target.slug === \"never\") return `<td class=\"interne\">${declared}</td>`;"
  },
  {
    "name": "non-admitted declared dependency hidden behind a dash",
    "find": "${declared === 0 ? \"—\" : declared}",
    "replace": "${\"—\"}"
  },
