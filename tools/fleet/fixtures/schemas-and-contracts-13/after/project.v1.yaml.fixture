# Fiche d'état du projet — autorité de l'état depuis ADR-0020 (design §6.2).
# La section statut du README est générée depuis cette fiche (sentinelles).
schema_version: libre-ai.project.v1
project: schemas-and-contracts
repository: libre-ai/schemas-and-contracts
kind: authority
layer: transverse
statement:
  for: "les projets de la constellation Libre AI"
  who_faces: "le coût et la dérive de machineries recopiées d'un repo à l'autre"
  enables: "consommer des contrats canoniques versionnés au lieu de copies divergentes"
  producing:
    - "des contrats et golden vectors que chaque consommateur vérifie byte-exact"
  without_depending_on:
    - "aucun service tiers, aucune copie non vérifiée — consommation épinglée et gates de dérive"
summary: "Autorité canonique des contrats : catalogue, vecteurs, politiques de compatibilité."
current_situation: >-
  Née verte en γ 3.3 (149 commits, 88 entrées de catalogue vérifiées) ; les produits et briques résolvent contrats, fixtures et datalog à travers cette git-dep épinglée.
scope:
  - "Autorité canonique des contrats : catalogue, vecteurs, politiques de compatibilité."
non_goals:
  - "aucune seconde implémentation durable de ce domaine ailleurs dans la constellation"
dependencies:
  - on: libre-ai/project-governance
    # 2026-10-07 : le dépôt nommé ici a été retiré (ADR-0041). Le pin précédent
    # désignait un commit désormais inatteignable ; il nomme son successeur, à une
    # révision qui existe. Aucun manifeste de ce dépôt ne dépendait du retiré :
    # mesuré sur 105 manifestes des 29 dépôts de l'organisation.
    why: "gabarit de flotte et gates de qualité"
    pinned: "github:libre-ai/project-governance#1c8b37c80beb41f640982768ec27304a911e0b8e"
maturity: usable
confidence: medium
exposure: usable-verifiable
freshness:
  last_verified_on: "2026-07-30"
scope_stability: stable
benchmark:
  none: "n/a (contract authority, no external parity target)"
phases:
  - id: service
    title: En service dans la constellation
    exit_criteria:
      - id: consumed-pinned
        text: "Les autorités de contrats sont consommées épinglées par SHA ; chaque copie vendorée en aval est vérifiée byte-exacte par un gate de dérive."
        weight: 1
        status: accepted
        evidence:
          date: "2026-07-29"
          reference: "gate-acceptance-log 2026-07-29 (ligne 3.3), PR hub #277"
      - id: compat-policy
        text: "L'API est couverte par une politique de compatibilité déclarée et un versionnage de rupture outillé."
        weight: 1
        status: pending
