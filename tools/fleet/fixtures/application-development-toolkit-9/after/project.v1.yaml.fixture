# Project state card — the state authority since ADR-0020 (design §6.2).
# The README status section is generated from this card (sentinels).
schema_version: libre-ai.project.v1
project: application-development-toolkit
repository: libre-ai/application-development-toolkit
kind: satellite
layer: couche-4
statement:
  for: "contributors assessing and developing this project's intended uses"
  who_faces: "recovered sources whose current integrated behavior still requires verification"
  enables: "inspecting the recovered implementation and running its declared checks before admission"
  producing:
    - "reproducible qualification evidence for the intended scope"
  without_depending_on:
    - "an implicit transfer of historical authority or an assumed passing CI run"
summary: "application-development-toolkit: recovered sources with documentary integration under review."
current_situation: >-
  Recovered source snapshot 5ec3630ece2a768872dfb67171c9b7fbf21a1aa9 is present.
  Product tests and CI were not rerun for this documentary integration; historical
  evidence is not qualification of this tree. No product admission or authority
  transfer is established. Historical responsibilities were held by libre-ai/ui,
  a repository since retired.
scope:
  - "Present consistent loading, success and error states across application screens."
  - "Give web adapters a common approach to handling requests and responses."
  - "Test a shared component within the application that uses it."
non_goals:
  - "Claiming operational readiness merely from the presence of recovered code."
  - "Transferring historical authority or consumers without separate reviewed admission."
dependencies:
