scope_stability: unstable
phases:
  - id: admission
    title: "Bounded capability admission"
    note: "Recovered code is present. Documentary checks do not accept product qualification criteria."
    exit_criteria:
      - id: qualified-scope
        text: "Select a useful module and verify its exact exports in a clean consumer. Test the actual supported browsers, keyboard use, narrow layouts and relevant display modes. Verify local asset handling and response behavior for any admitted web module. Review merged-source rights, dependencies and visual assets separately; test infrastructure does not prove a production database or application journey."
        weight: 1
